{
  "name": "pi-coder-tuned",
  "version": "0.1.0",
  "description": "English-first fork of pi-coder with cache-safe local recaps, turn timing, and compact context-token counts: 30 extensions and 3 themes.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "extensions",
    "themes",
    "theme",
    "statusline",
    "tui",
    "terminal",
    "coding-agent",
    "agent"
  ],
  "homepage": "https://github.com/Demontager/pi-coder-tuned#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demontager/pi-coder-tuned.git"
  },
  "bugs": {
    "url": "https://github.com/Demontager/pi-coder-tuned/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "themes",
    "config",
    "docs",
    "tools",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4",
    "check:english": "node tools/localize.mjs",
    "localize": "node tools/localize.mjs --write"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
